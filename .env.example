# Copy to .env (or .env.local for local overrides) for development.
# Never commit .env / .env.local (SEC-CRY-08).
DATABASE_URL=postgres://votemax:votemax_dev_only@localhost:5432/votemax
REDIS_URL=redis://localhost:6379
API_PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NODE_ENV=development

# OTP delivery (DEC-004). Without providers, codes go to the dev outbox only
# outside production; production fails closed (F-04).
# SMTP_HOST=localhost
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=votemax@example.org
# Africa's Talking SMS:
# AT_API_KEY=
# AT_USERNAME=
# AT_SENDER_ID=
# Generic SMS webhook (JSON POST {to, message}):
# SMS_WEBHOOK_URL=
# SMS_WEBHOOK_AUTH=
