{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "install": {
      "commands": [
        "...",
        "npm install --include=dev"
      ]
    },
    "build": {
      "inputs": ["...", { "step": "install" }],
      "commands": [
        "npm run build:api"
      ]
    }
  },
  "deploy": {
    "startCommand": "npm run db:migrate -w @votery/api && node apps/api/dist/main.js"
  }
}
